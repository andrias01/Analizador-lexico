# Plantilla de secretos de Paisascript.
#
# USO LOCAL
#   1. Copie este archivo como  .streamlit/secrets.toml
#   2. Reemplace el valor de ejemplo por su clave real
#   3. NO lo suba a GitHub: .streamlit/secrets.toml esta en .gitignore
#
# USO EN STREAMLIT CLOUD
#   No hace falta subir ningun archivo. Vaya a la app publicada:
#   Manage app -> Settings -> Secrets, y pegue AHI el mismo contenido
#   (sin los comentarios). La app lo lee automaticamente.

OPENAI_API_KEY = "sk-proj-reemplace-esto-por-su-clave-real"

# Opcional: modelo a usar. Si se omite, la app usa "gpt-4o-mini".
# OPENAI_MODEL = "gpt-4o-mini"
